<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Capacidad "Keychain Sharing" (requisito de flutter_secure_storage).
		El grupo vacio deja que el keychain use el grupo por defecto de la app,
		identico a la capacidad creada desde Xcode.
	-->
	<key>keychain-access-groups</key>
	<array/>
</dict>
</plist>
